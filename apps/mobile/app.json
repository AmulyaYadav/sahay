{
  "expo": {
    "name": "Sahay",
    "slug": "sahay",
    "version": "0.1.0",
    "scheme": "sahay",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F6F7F9",
    "splash": {
      "image": "./assets/adaptive-icon.png",
      "backgroundColor": "#2F6BE4",
      "resizeMode": "contain"
    },
    "newArchEnabled": true,
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "org.sahay.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Sahay uses your approximate location (about 100 m) only while you are requesting help or in Helping Now mode, to find the nearest match. It is deleted within 15 minutes."
      }
    },
    "android": {
      "package": "org.sahay.app",
      "permissions": [
        "ACCESS_COARSE_LOCATION"
      ],
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2F6BE4"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Sahay uses your approximate location (about 100 m) only while requesting help or helping, to find the nearest match. It is deleted within 15 minutes.",
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "7e26dee7-760c-40e5-8e41-0cb457dbfd51"
      }
    },
    "owner": "asdc123",
    "icon": "./assets/icon.png"
  }
}

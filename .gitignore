# wrangler's local dev state (miniflare cache, temp bundles) — machine-local
.wrangler/
# Generated by `expo prebuild` — regenerate rather than commit. Committing it
# would fork the native project away from app.json and the config plugins.
apps/mobile/android/
apps/mobile/ios/

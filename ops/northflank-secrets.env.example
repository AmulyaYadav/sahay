# Runtime variables for the Northflank free-tier deployment.
#
# Northflank secret groups can import a .env file: Project → Secrets → create a
# group → import. Both the api and worker services and the migration job inherit
# the group, so these are entered once rather than three times.
#
# Fill the <angle brackets>, save as a local copy (NOT in the repo — .env.prod
# and .env are gitignored, this .example file is the only committed version),
# import it, then delete the local copy.
#
# REDIS_URL is deliberately absent: link the Redis addon to this secret group
# instead and alias its connection variable to REDIS_URL, so the credential
# never exists as a literal. See docs/deploy-free-tier.md.

NODE_ENV=production
PORT=4000
HOST=0.0.0.0

# Supabase → Settings → Database → Connection string → URI.
# Use the POOLER host (free-tier direct connections are IPv6-only), session mode.
DATABASE_URL=<supabase-pooler-uri>

# Managed Postgres requires TLS. 'require' encrypts without verifying the chain;
# switch to 'verify' if Supabase's chain validates for you.
DATABASE_SSL=require

# Per process, and two processes run (api + worker). Supabase free caps total
# connections, so this stays well below the default 20.
DATABASE_POOL_MAX=8

# Two DIFFERENT 32-byte hex values: openssl rand -hex 32
# The server refuses to start in production if they match or look like examples.
# PII_ENCRYPTION_KEY decrypts stored email addresses; IDENTITY_HMAC_KEY builds
# the blind index used to find accounts. Losing either is unrecoverable.
PII_ENCRYPTION_KEY=<64-hex-chars>
IDENTITY_HMAC_KEY=<64-hex-chars-different-from-above>

# Required: production refuses EMAIL_PROVIDER=console. The web console never
# emails anyone, but mobile OTP does and the guard is unconditional.
EMAIL_PROVIDER=resend
RESEND_API_KEY=<resend-api-key>
RESEND_FROM=onboarding@resend.dev

# ~125ms per password check instead of ~250ms. Hashing is synchronous and stalls
# the event loop, so this keeps logins from delaying other requests on a small
# shared-CPU instance. Not a memory measure. Existing hashes are unaffected.
SCRYPT_COST_LOG2=15

# Production CORS allows exactly this one origin. It must match the site's real
# URL or every browser request fails with what looks like the API being down.
WEB_ORIGIN=https://sahay.online
